{
  "name": "mikro-orm-poc",
  "version": "0.3.3",
  "description": "MikroORM typescript ORM Proof Of Concept + Vitest testing",
  "main": "dist/app.js",
  "scripts": {
    "setup": "npm run schema:create && npm run seed:run && npm run dev",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn src/app.ts",
    "dev:debug": "ts-node-dev -r tsconfig-paths/register --inspect=localhost:5001 src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "db:migrations:deploy": "npx mikro-orm migration:up",
    "db:seeders:deploy": "tsx src/db/seeders/seed.ts",
    "seed:run": "tsx src/db/seeders/seed.ts",
    "schema:create": "mikro-orm schema:create -r",
    "schema:update": "mikro-orm schema:update -r",
    "schema:drop": "mikro-orm schema:drop -r",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "spinningideas",
  "license": "MIT",
  "dependencies": {
    "@mikro-orm/cli": "^7.2.1",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/decorators": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/postgresql": "^7.2.1",
    "@mikro-orm/reflection": "^7.2.1",
    "@mikro-orm/seeder": "^7.2.1",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "ts-node-dev": "^2.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
